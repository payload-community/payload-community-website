{
  "name": "payload-community-portal",
  "version": "1.0.0",
  "description": "Payload CMS Community Portal",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm i18n:compile && cross-env NODE_OPTIONS=--no-deprecation next build && next-sitemap --config next-sitemap.config.cjs",
    "cli": "cross-env NODE_OPTIONS=--no-deprecation tsx src/cli/index.ts",
    "dev": "pnpm i18n:compile && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && pnpm start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "i18n:check": "lingui check sync --clean",
    "i18n:compile": "lingui compile --strict",
    "i18n:extract": "lingui extract --clean",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint . --fix",
    "migrate": "pnpm cli migrate",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed": "pnpm cli seed",
    "seed:dev": "pnpm cli seed-dev",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:e2e": "pnpm i18n:compile && cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:unit": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "typecheck": "pnpm i18n:compile && tsc --noEmit",
    "worker": "pnpm cli worker"
  },
  "dependencies": {
    "@lingui/core": "6.9.0",
    "@lingui/react": "6.9.0",
    "@next/third-parties": "16.3.3",
    "@payloadcms/admin-bar": "3.90.2",
    "@payloadcms/db-mongodb": "3.90.2",
    "@payloadcms/email-nodemailer": "3.90.2",
    "@payloadcms/live-preview-react": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/plugin-redirects": "3.90.2",
    "@payloadcms/plugin-seo": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slot": "^1.0.2",
    "@react-email/render": "2.1.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "geist": "^1.3.0",
    "graphql": "^16.8.2",
    "lucide-react": "0.563.0",
    "next": "16.3.3",
    "next-sitemap": "^4.2.3",
    "nuqs": "2.10.2",
    "payload": "3.90.2",
    "payload-oauth2": "1.0.21",
    "prism-react-renderer": "^2.3.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-email": "6.11.1",
    "react-hook-form": "7.71.1",
    "sharp": "0.35.4",
    "tailwind-merge": "^3.4.0",
    "vanilla-cookieconsent": "3.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@lingui/cli": "6.9.0",
    "@lingui/format-po": "6.9.0",
    "@lingui/swc-plugin": "6.1.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/react": "16.3.0",
    "@types/escape-html": "^1.0.2",
    "@types/node": "24.19.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.3",
    "eslint-plugin-lingui": "0.16.0",
    "jsdom": "28.0.0",
    "postcss": "^8.5.28",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.1.18",
    "tsx": "4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "private": true,
  "packageManager": "pnpm@11.18.0"
}
