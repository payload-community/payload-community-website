# Payload CMS Community Portal environment variables.
# Copy to `.env` and fill in. Values below are DDEV defaults or placeholders.
# See docs/getting-started.md for details.

# --- Core ---------------------------------------------------------------
# MongoDB connection string (DDEV: service `mongo`, user/password db/db)
DATABASE_URI=mongodb://db:db@mongo:27017/plc?authSource=admin
# Used to sign JWTs and encrypt secrets. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=
# Public URL of the site, no trailing slash. Used for CORS, links and OAuth callbacks.
NEXT_PUBLIC_SERVER_URL=https://plc.ddev.site:3000
# Bearer token for GET /api/payload-jobs/run (CronJob mode). Generate with: openssl rand -hex 32
CRON_SECRET=
# Validates draft preview requests (/next/preview). Generate with: openssl rand -hex 32
PREVIEW_SECRET=

# --- GitHub ---------------------------------------------------------------
# Token for the GitHub API used by the plugin sync (public_repo read is enough)
GITHUB_TOKEN=
# GitHub OAuth App; callback: ${NEXT_PUBLIC_SERVER_URL}/api/users/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Google ---------------------------------------------------------------
# Google OAuth client; redirect URI: ${NEXT_PUBLIC_SERVER_URL}/api/users/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Admins ---------------------------------------------------------------
# Comma-separated GitHub logins / emails that get the admin role on sign-in
ADMIN_GITHUB_LOGINS=
ADMIN_EMAILS=

# --- S3 storage (Garage) ---------------------------------------------------
# S3 API endpoint (may be cluster-internal)
S3_ENDPOINT=http://garage:3900
S3_REGION=garage
S3_BUCKET=garage
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Public base URL that serves bucket objects (Garage web endpoint), no trailing slash
S3_PUBLIC_URL=https://garage.plc.ddev.site:3902
# Optional key prefix prepended to all upload prefixes (`e2e` in end-to-end tests)
S3_KEY_PREFIX=

# --- Analytics ------------------------------------------------------------
# Google Analytics 4 measurement ID (optional; loaded only after consent)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Email (SMTP) ---------------------------------------------------------
# DDEV: Mailpit at 127.0.0.1:1025, UI at https://plc.ddev.site:8026
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=noreply@plc.ddev.site
EMAIL_FROM_NAME=Payload Community Portal

# --- Observability --------------------------------------------------------
# OpenTelemetry (optional; tracing is disabled when the endpoint is empty)
OTEL_SERVICE_NAME=payload-community-portal
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
